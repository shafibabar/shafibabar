<mxfile host="drawio" type="device">
  <diagram id="sample-flow" name="Sample flow">
    <mxGraphModel dx="1200" dy="420" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" value="Process" parent="0" />
        <mxCell id="n1" value="Request received" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#3B475C;strokeWidth=1.5;fontColor=#0B1220;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="160" height="64" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Validate input" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#3B475C;strokeWidth=1.5;fontColor=#0B1220;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="260" y="120" width="160" height="64" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E9EEF8;strokeColor=#2447E0;strokeWidth=1.5;fontColor=#0B1220;fontSize=15;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="480" y="107" width="120" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Process" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#3B475C;strokeWidth=1.5;fontColor=#0B1220;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="660" y="120" width="160" height="64" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Store result" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#3B475C;strokeWidth=1.5;fontColor=#0B1220;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="880" y="120" width="160" height="64" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="Notify user" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#2447E0;strokeColor=#15289A;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=15;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="880" y="270" width="160" height="64" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="Return error" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#55617A;strokeWidth=1.5;dashed=1;fontColor=#0B1220;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="460" y="270" width="160" height="64" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3B475C;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3B475C;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n2" target="n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3B475C;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0B1220;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n3" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55617A;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontColor=#0B1220;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n3" target="n7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3B475C;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3B475C;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n5" target="n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="Annotations" parent="0" />
        <mxCell id="a1" value="Component demo: neutral sample flow, not a real system" style="text;html=1;align=left;verticalAlign=middle;fontColor=#55617A;fontSize=13;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="L2">
          <mxGeometry x="40" y="40" width="420" height="30" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="Failed checks end here; nothing is stored" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#55617A;fontSize=13;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="L2">
          <mxGeometry x="640" y="287" width="200" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
